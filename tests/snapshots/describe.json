      {
        "name": "convert",
        "description": "Read a table from SOURCE and write it to TARGET; report both sides.\n\nOptions both sides have take --in- (the source) or --out- (the target).\n--query is SQL over the source whose result is written: inside a base\nit names its tables, over any other source the table is data.\nWith --dry-run the report comes back and nothing is written.\nA TARGET that is the SOURCE itself asks first: --confirm skips the question.\nSOURCE - is stdin, its format comes from the content; TARGET - is stdout:\nCSV, one value per line for one column, or --out-format; under --json the\ndata is inside the envelope as data.\n\nExample: dataio convert a.csv b.csv --json",
        "options": [
          {
            "name": "--in-format",
            "arguments": [
              {
                "name": "IN_FORMAT",
                "required": true
              }
            ],
            "description": "Source: Format name; wins over the extension (see the formats command).",
            "metadata": [
              {
                "name": "x-rb-type",
                "value": "str"
              }
            ]
          },
          {
            "name": "--in-sheet",
            "arguments": [
              {
                "name": "IN_SHEET",
                "required": true
              }
            ],
            "description": "Source: Sheet name; wins over the part of the address after #.",
            "metadata": [
              {
                "name": "x-rb-type",
                "value": "str"
              }
            ]
          },
          {
            "name": "--in-table",
            "arguments": [
              {
                "name": "IN_TABLE",
                "required": true
              }
            ],
            "description": "Source: Table name; wins over the part of the address after #.",
            "metadata": [
              {
                "name": "x-rb-type",
                "value": "str"
              }
            ]
          },
          {
            "name": "--in-encoding",
            "arguments": [
              {
                "name": "IN_ENCODING",
                "required": true
              }
            ],
            "description": "Source: Text encoding, e.g. utf-8 or cp1251.",
            "metadata": [
              {
                "name": "x-rb-type",
                "value": "str"
              }
            ]
          },
          {
            "name": "--in-sep",
            "arguments": [
              {
                "name": "IN_SEP",
                "required": true
              }
